C2_RELAY_ENVIRONMENT=development
C2_RELAY_DATABASE_URL=sqlite+pysqlite:///./c2-relay.db
C2_RELAY_LOG_LEVEL=INFO
# Required to enable enrollment and operator endpoints. Generate a high-entropy value.
C2_RELAY_BOOTSTRAP_TOKEN=
C2_RELAY_SERVER_HOST=127.0.0.1
C2_RELAY_SERVER_PORT=8000
C2_RELAY_AGENT_SERVER_URL=http://127.0.0.1:8000
C2_RELAY_AGENT_STATE_PATH=./agent-state.json
C2_RELAY_AGENT_POLL_INTERVAL=5
C2_RELAY_AGENT_REQUEST_TIMEOUT=10
C2_RELAY_AGENT_MAX_BACKOFF=60
